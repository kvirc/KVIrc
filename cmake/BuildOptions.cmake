option(WANT_DEBUG "Use Debug when no build configuration is specified" OFF)
option(WANT_ENV_FLAGS "Skip optional KVIrc compiler flags" OFF)
option(WANT_STRIP "Strip Release and MinSizeRel binaries during installation" OFF)
set(WANT_SANITIZER OFF CACHE STRING "Sanitizer for Debug and RelWithDebInfo builds")
set_property(CACHE WANT_SANITIZER PROPERTY STRINGS OFF ADDRESS MEMORY THREAD)

if(NOT CMAKE_CONFIGURATION_TYPES)
	if(CMAKE_BUILD_TYPE STREQUAL "Release-stripped")
		# Older versions used this cache value when WANT_STRIP was enabled.
		set(CMAKE_BUILD_TYPE Release)
		set_property(CACHE CMAKE_BUILD_TYPE PROPERTY VALUE "${CMAKE_BUILD_TYPE}")
	elseif("${CMAKE_BUILD_TYPE}" STREQUAL "")
		if(WANT_DEBUG OR DEBUG OR WITH_DEBUG)
			set(CMAKE_BUILD_TYPE Debug)
		else()
			set(CMAKE_BUILD_TYPE Release)
		endif()
		set_property(CACHE CMAKE_BUILD_TYPE PROPERTY VALUE "${CMAKE_BUILD_TYPE}")
	endif()
endif()

set(KVIRC_DEBUG_CONFIG "$<OR:$<CONFIG:Debug>,$<CONFIG:RelWithDebInfo>>")
set(KVIRC_RELEASE_CONFIG "$<OR:$<CONFIG:Release>,$<CONFIG:MinSizeRel>>")

string(TOUPPER "${CMAKE_BUILD_TYPE}" kvirc_build_type)
if(CMAKE_CONFIGURATION_TYPES)
	set(CMAKE_STATUS_DEBUG_SUPPORT "Enabled in Debug and RelWithDebInfo")
elseif(kvirc_build_type STREQUAL "DEBUG" OR kvirc_build_type STREQUAL "RELWITHDEBINFO")
	set(CMAKE_STATUS_DEBUG_SUPPORT "Yes")
else()
	set(CMAKE_STATUS_DEBUG_SUPPORT "No")
endif()

if(NOT WANT_ENV_FLAGS AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND NOT MINGW)
	include(CheckCXXCompilerFlag)
	check_cxx_compiler_flag("-fvisibility=hidden" CXX_HAS_VH_FLAG)
	check_cxx_compiler_flag("-fvisibility-inlines-hidden" CXX_HAS_VIH_FLAG)
endif()

string(TOUPPER "${WANT_SANITIZER}" KVIRC_SANITIZER)
set(KVIRC_SANITIZER_FLAG "")
if(KVIRC_SANITIZER STREQUAL "ADDRESS")
	set(KVIRC_SANITIZER_FLAG "-fsanitize=address,undefined")
elseif(KVIRC_SANITIZER STREQUAL "MEMORY")
	set(KVIRC_SANITIZER_FLAG "-fsanitize=memory")
elseif(KVIRC_SANITIZER STREQUAL "THREAD")
	set(KVIRC_SANITIZER_FLAG "-fsanitize=thread")
elseif(NOT KVIRC_SANITIZER STREQUAL "OFF")
	message(FATAL_ERROR "Invalid WANT_SANITIZER value: ${WANT_SANITIZER}. Use OFF, ADDRESS, MEMORY or THREAD.")
endif()

if(KVIRC_SANITIZER_FLAG AND (CMAKE_CONFIGURATION_TYPES OR CMAKE_STATUS_DEBUG_SUPPORT STREQUAL "Yes"))
	include(CheckCXXSourceCompiles)
	include(CMakePushCheckState)
	cmake_push_check_state()
	string(APPEND CMAKE_REQUIRED_FLAGS " ${KVIRC_SANITIZER_FLAG}")
	list(APPEND CMAKE_REQUIRED_LINK_OPTIONS "${KVIRC_SANITIZER_FLAG}")
	check_cxx_source_compiles("int main() { return 0; }" KVIRC_HAS_SANITIZER_${KVIRC_SANITIZER})
	cmake_pop_check_state()
	if(NOT KVIRC_HAS_SANITIZER_${KVIRC_SANITIZER})
		message(FATAL_ERROR "The selected toolchain cannot compile and link with WANT_SANITIZER=${WANT_SANITIZER}")
	endif()
	string(APPEND CMAKE_STATUS_DEBUG_SUPPORT " (sanitizer: ${KVIRC_SANITIZER})")
elseif(KVIRC_SANITIZER_FLAG)
	message(STATUS "WANT_SANITIZER=${WANT_SANITIZER} applies only to Debug and RelWithDebInfo")
endif()

function(kvirc_apply_build_options target)
	target_compile_definitions(${target} PRIVATE "$<${KVIRC_DEBUG_CONFIG}:COMPILE_DEBUG_MODE=1>")

	if(MSVC)
		# The executable, kvilib and modules exchange objects across DLL boundaries.
		set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
	endif()

	if(NOT WANT_ENV_FLAGS)
		if(MSVC)
			target_compile_options(${target} PRIVATE
				"$<$<COMPILE_LANGUAGE:C,CXX>:/utf-8>"
				"$<$<COMPILE_LANGUAGE:CXX>:/MP;/Zc:wchar_t;/EHsc>"
				"$<$<AND:${KVIRC_RELEASE_CONFIG},$<COMPILE_LANGUAGE:C,CXX>>:/Gw>"
			)
		elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND NOT MINGW)
			if(CXX_HAS_VH_FLAG)
				target_compile_options(${target} PRIVATE
					"$<$<AND:${KVIRC_DEBUG_CONFIG},$<COMPILE_LANGUAGE:CXX>>:-fvisibility=hidden>"
				)
			endif()
			if(CXX_HAS_VIH_FLAG)
				target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:-fvisibility-inlines-hidden>")
			endif()
		endif()
	endif()

	if(KVIRC_SANITIZER_FLAG)
		target_compile_options(${target} PRIVATE
			"$<$<AND:${KVIRC_DEBUG_CONFIG},$<COMPILE_LANGUAGE:C,CXX>>:${KVIRC_SANITIZER_FLAG};-fno-omit-frame-pointer>"
		)
		target_link_options(${target} PRIVATE "$<${KVIRC_DEBUG_CONFIG}:${KVIRC_SANITIZER_FLAG}>")
		get_target_property(target_type ${target} TYPE)
		if(KVIRC_SANITIZER STREQUAL "MEMORY" AND target_type STREQUAL "EXECUTABLE")
			target_compile_options(${target} PRIVATE "$<${KVIRC_DEBUG_CONFIG}:-fPIE>")
			target_link_options(${target} PRIVATE "$<${KVIRC_DEBUG_CONFIG}:-pie>")
		endif()
	endif()
endfunction()

if(WANT_STRIP)
	if(CMAKE_STRIP)
		# Set this before the install rules for the targets are generated.
		install(CODE [[
			string(TOUPPER "${CMAKE_INSTALL_CONFIG_NAME}" kvirc_install_config)
			if(kvirc_install_config MATCHES "^(RELEASE|MINSIZEREL)$")
				set(CMAKE_INSTALL_DO_STRIP TRUE)
			endif()
		]])
	else()
		message(WARNING "WANT_STRIP is enabled but the toolchain does not provide CMAKE_STRIP")
	endif()
endif()
